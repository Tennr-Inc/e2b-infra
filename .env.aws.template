# ------------------------------------------- Required block -----------------------------------------------------------
# These variables are required and don't have default values
# You must provide values for these to run the deployment successfully

AWS_PROFILE=
AWS_ACCOUNT_ID=
AWS_REGION=

# Private DNS suffix used by the shared E2B API and sandbox wildcard hostnames.
# Example: e2b.internal.example.com
DOMAIN_NAME=

# AWS accounts or roles allowed to create interface endpoints to E2B. Use the
# consumer-account root principal when the account owns the endpoint.
# Example: ["arn:aws:iam::111122223333:root","arn:aws:iam::444455556666:root"]
PRIVATELINK_ALLOWED_PRINCIPAL_ARNS=

# Existing ACM certificate covering *.${DOMAIN_NAME}. Leave empty to have
# Terraform request one; `make request-certificate` prints the public DNS CNAME
# that must be added in the authoritative DNS provider. The CNAME validates the
# certificate only and does not expose the internal load balancer.
INGRESS_CERTIFICATE_ARN=

# Optional public Route53 hosted zone for automatic ACM DNS validation. This
# record proves domain ownership only; service records remain private.
INGRESS_CERTIFICATE_VALIDATION_ZONE_ID=

# Dedicated, non-overlapping E2B VPC layout. JSON lists must not contain spaces.
VPC_CIDR=
VPC_AVAILABILITY_ZONES=
VPC_PUBLIC_SUBNETS=
VPC_PRIVATE_SUBNETS=
VPC_ELASTICACHE_SUBNETS=

# ------------------------------------------- Required with defaults ---------------------------------------------------
# These variables need to be specified but have default values

PROVIDER=aws
# prefix identifier for all resources
PREFIX=e2b-shared-

# This cluster serves both staging and production teams.
TERRAFORM_ENVIRONMENT=shared

# ------------------------------------------- Optional block -----------------------------------------------------------
# Following variables are optional and doesn't have to be set

# Pull a released, prebuilt docker images from E2B's artifact
# registry instead of building it from source. When set, `make build-and-upload`
# pulls this version and mirrors it into your own core repo (caching it locally).
# Leave empty to build from source. Example: v0.1.0
CLIENT_PROXY_VERSION=
CLICKHOUSE_MIGRATOR_VERSION=

# Create the docker-reverse-proxy ECR repository (default: true)
# The component is deprecated and no AWS Nomad job consumes this repository.
# Set to false to stop creating it. Flipping an existing cluster to false
# destroys the repository, which fails while it still holds images unless
# ALLOW_FORCE_DESTROY is also set.
DOCKER_REVERSE_PROXY_ENABLED=

# Sandbox firewall: comma-separated CIDRs to allow through the private-range deny list
# ALLOW_SANDBOX_INTERNAL_CIDRS=

# A 64 GiB build host can run the 24 GiB project maximum while retaining room
# for Nomad, template-manager, and Firecracker huge pages. The 500 GiB encrypted
# build-node root volume provides host-side layer/cache capacity.
BUILD_SERVER_MACHINE_TYPE=m8i.4xlarge

# Keep false for the first deployment. Enable after the ALB is stable.
ENABLE_LOAD_BALANCER_DELETION_PROTECTION=false

# EBS, RDS, and application S3 data use separate rotating customer-managed
# keys. AWS permits a deletion waiting period from 7 through 30 days.
KMS_KEY_DELETION_WINDOW_DAYS=30

# Private administration through an EC2 Instance Connect endpoint.
USE_INSTANCE_CONNECT=true

# Managed Valkey/Redis. TLS, at-rest encryption, Multi-AZ failover, and seven
# days of snapshots are enabled by Terraform.
REDIS_MANAGED=true
REDIS_INSTANCE_TYPE=cache.t4g.small
REDIS_REPLICA_SIZE=2

# Private RDS PostgreSQL. This shared cluster carries production state, so use
# Multi-AZ, deletion protection, and final snapshots.
POSTGRES_ENGINE_VERSION=16.11
# Optional connector security groups used only for private database bootstrap.
POSTGRES_ADMIN_INGRESS_SECURITY_GROUP_IDS='[]'
POSTGRES_INSTANCE_CLASS=db.t4g.small
POSTGRES_ALLOCATED_STORAGE=20
POSTGRES_MAX_ALLOCATED_STORAGE=100
POSTGRES_MULTI_AZ=true
POSTGRES_BACKUP_RETENTION_PERIOD=7
POSTGRES_DELETION_PROTECTION=true
POSTGRES_SKIP_FINAL_SNAPSHOT=false
